generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователи
model User {
  id            String   @id @default(uuid())
  telegramId    String?  @unique
  firstName     String
  lastName      String?
  username      String?
  photoUrl      String?
  phone         String?
  email         String?
  role          Role     @default(STUDENT)
  balance       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  bookings      Booking[]
  payments      Payment[]
  votes         Vote[]
  groupStudents GroupStudent[]
  
  // Trainer relations
  classes       Class[]   @relation("ClassTrainer")
  groups        Group[]   @relation("GroupTrainer")
  
  // Balance audit
  balanceTransactions BalanceTransaction[]
  passes        Pass[]
  notifications Notification[]
  notificationSettings UserNotificationSettings?
  
  // Referral relations
  referralsMade Referral[] @relation("Referrer")
  referralsReceived Referral[] @relation("Referred")
  reviews       Review[]
  activityLogs  ActivityLog[]
  waitlists     Waitlist[]

  @@index([role])
  // telegramId уже имеет @unique, отдельный @@index не нужен
  @@map("users")
}

enum Role {
  STUDENT
  TRAINER
  ADMIN
}

// Группы занятий
model Group {
  id             String      @id @default(uuid())
  name           String
  description    String?
  groupType      GroupType   @default(REGULAR)
  pricingType    PricingType @default(FIXED)  // Только для REGULAR: FIXED или DYNAMIC
  fixedPrice     Int         @default(1)      // Для REGULAR FIXED: сколько занятий списывать
  intensivePrice Int?                         // Для INTENSIVE: стоимость в рублях (единая цена)
  maxStudents    Int         @default(15)
  telegramChat   String?                      // Ссылка или @username чата (для отображения)
  telegramChatId String?                      // Числовой ID чата для Telegram Bot API
  trainerId      String?
  startsAt       DateTime?                    // Для INTENSIVE: дата начала
  endsAt         DateTime?                    // Для INTENSIVE: дата окончания
  createdAt      DateTime    @default(now())
  
  // Relations
  trainer       User?    @relation("GroupTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  schedules     Schedule[]
  students      GroupStudent[]
  votings       Voting[]
  reviews       Review[]
  waitlists     Waitlist[]

  @@index([trainerId])
  @@index([groupType])
  @@index([telegramChatId])
  @@map("groups")
}

enum GroupType {
  REGULAR     // Регулярные — еженедельные, бессрочные
  INTENSIVE   // Интенсив — разовое событие (1-7 дней)
}

enum PricingType {
  FIXED       // Фиксированная — списание с баланса при голосовании
  DYNAMIC     // Динамическая — цена определяется после голосования
}

// Расписание группы (шаблон)
model Schedule {
  id          String   @id @default(uuid())
  groupId     String
  dayOfWeek   Int      // 0-6 (воскресенье-суббота)
  time        String   // "07:30"
  description String?  // "ОФП", "Хатха" и т.д.
  
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  classes     Class[]

  @@index([groupId])
  @@map("schedules")
}

// Связь группа-студент
model GroupStudent {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  joinedAt  DateTime @default(now())
  
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
  @@map("group_students")
}

// Занятия
model Class {
  id              String    @id @default(uuid())
  scheduleId      String
  trainerId       String
  date            DateTime
  maxStudents     Int       @default(15)
  price           Int       @default(700)
  status          ClassStatus @default(SCHEDULED)
  createdAt       DateTime  @default(now())
  
  schedule        Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  trainer         User      @relation("ClassTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  bookings        Booking[]

  @@index([scheduleId])
  @@index([trainerId])
  @@index([date])
  @@index([status])
  @@map("classes")
}

enum ClassStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

// Бронирования
model Booking {
  id          String        @id @default(uuid())
  userId      String
  classId     String
  status      BookingStatus @default(CONFIRMED)
  createdAt   DateTime      @default(now())
  
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  class       Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendance  Attendance?
  passUsage   PassUsage?    // Связь с использованием абонемента

  @@index([userId])
  @@index([classId])
  @@index([status])
  @@map("bookings")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

// Платежи
model Payment {
  id          String        @id @default(uuid())
  userId      String
  amount      Int
  classesCount Int
  status      PaymentStatus @default(PENDING)
  provider    String        // "tbank", "telegram_stars"
  externalId  String?
  createdAt   DateTime      @default(now())
  
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([externalId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Транзакции баланса (аудит)
model BalanceTransaction {
  id          String    @id @default(uuid())
  userId      String
  amount      Int       // Положительное = начисление, отрицательное = списание
  type        TransactionType
  description String?
  
  // Связанные сущности (опционально)
  bookingId   String?
  paymentId   String?
  voteId      String?
  votingId    String?
  
  createdAt   DateTime  @default(now())
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([bookingId])
  @@index([paymentId])
  @@index([voteId])
  @@map("balance_transactions")
}

enum TransactionType {
  BOOKING_DEDUCTION     // Списание за запись
  BOOKING_REFUND        // Возврат за отмену
  PAYMENT_CREDIT        // Начисление за оплату
  MANUAL_ADJUSTMENT     // Ручная корректировка
  INTENSIVE_DEDUCTION   // Списание за интенсив
  VOTE_DEDUCTION        // Списание за голос (фикс. цена)
  VOTE_REFUND           // Возврат за отмену голоса
  CLASS_CANCELLED       // Возврат — занятие не состоялось
  PAYMENT_REFUND        // Отметка возврата платежа
}

// Голосования
model Voting {
  id              String        @id @default(uuid())
  groupId         String
  title           String
  type            VotingType    @default(SCHEDULE)
  chargeOnVote    Boolean       @default(false)  // Списывать с баланса при голосовании
  multipleChoice  Boolean       @default(true)   // Множественный выбор вариантов
  minParticipants Int           @default(1)
  deadline        DateTime
  weekStart       DateTime?                      // Начало периода голосования
  weekEnd         DateTime?                      // Конец периода голосования
  status          VotingStatus  @default(ACTIVE)
  telegramPollId  String?                        // ID нативного Telegram Poll (для poll_answer)
  telegramMsgId   String?                        // ID сообщения в чате (для stopPoll)
  telegramChatId  String?                        // Chat ID где отправлен poll
  createdAt       DateTime      @default(now())
  
  group           Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  options         VotingOption[]
  votes           Vote[]

  @@index([groupId])
  @@index([status])
  @@index([telegramPollId])
  @@map("votings")
}

enum VotingType {
  SCHEDULE    // Еженедельное расписание (кто когда придёт)
  CONFIRM     // Подтверждение конкретного занятия
  SURVEY      // Произвольный опрос (без списания)
}

enum VotingStatus {
  ACTIVE      // Идёт голосование
  FINALIZED   // Итоги подведены (тренер назначил цены для DYNAMIC)
  CLOSED      // Закрыто
  CANCELLED   // Отменено (возврат всем)
}

// Варианты голосования
model VotingOption {
  id          String    @id @default(uuid())
  votingId    String
  dayOfWeek   Int
  time        String
  date        DateTime?              // Конкретная дата (для интенсивов)
  description String?                // "ОФП", "Хатха" и т.д.
  finalPrice  Int?                   // Цена назначенная тренером (для DYNAMIC, в рублях)
  paymentLink String?                // Ссылка T-Bank для оплаты (для DYNAMIC)
  cancelled   Boolean   @default(false) // Занятие отменено
  
  voting      Voting    @relation(fields: [votingId], references: [id], onDelete: Cascade)
  votes       Vote[]

  @@index([votingId])
  @@map("voting_options")
}

// Голоса
model Vote {
  id              String    @id @default(uuid())
  votingId        String
  optionId        String
  userId          String
  balanceCharged  Boolean   @default(false)  // Были ли списаны занятия с баланса
  paidAmount      Int?                       // Оплаченная сумма (для DYNAMIC, в рублях)
  paidAt          DateTime?                  // Когда оплатил (для DYNAMIC)
  refunded        Boolean   @default(false)  // Был ли возврат
  refundedAt      DateTime?                  // Когда был возврат
  createdAt       DateTime  @default(now())
  
  voting          Voting       @relation(fields: [votingId], references: [id], onDelete: Cascade)
  option          VotingOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId]) // Один пользователь - один голос за вариант
  @@index([votingId])
  @@index([userId])
  @@index([optionId])
  @@map("votes")
}

// Абонементы учеников
model Pass {
  id            String      @id @default(uuid())
  userId        String
  type          PassType
  classesTotal  Int         // Общее количество занятий (0 для UNLIMITED)
  classesUsed   Int         @default(0) // Использовано занятий
  validDays     Int         // Срок действия в днях
  validFrom     DateTime    // Дата начала действия
  validUntil    DateTime    // Дата окончания действия
  status        PassStatus  @default(ACTIVE)
  createdAt     DateTime    @default(now())
  
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages        PassUsage[] // История использования абонемента

  @@index([userId])
  @@index([status])
  @@index([validUntil])
  @@map("passes")
}

// История использования абонемента (связь Pass <-> Booking)
model PassUsage {
  id        String   @id @default(uuid())
  passId    String
  bookingId String   @unique
  usedAt    DateTime @default(now())
  
  pass      Pass     @relation(fields: [passId], references: [id], onDelete: Cascade)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([passId])
  // bookingId уже имеет @unique, отдельный @@index не нужен
  @@map("pass_usages")
}

enum PassType {
  CLASSES_4       // Абонемент на 4 занятия
  CLASSES_8       // Абонемент на 8 занятий
  CLASSES_12      // Абонемент на 12 занятий
  UNLIMITED_30    // Безлимит на 30 дней
  UNLIMITED_90    // Безлимит на 90 дней
}

enum PassStatus {
  ACTIVE      // Действует
  EXPIRED     // Истёк по сроку
  EXHAUSTED   // Исчерпан (все занятия использованы)
  CANCELLED   // Отменён
}

// История посещений
model Attendance {
  id            String            @id @default(uuid())
  bookingId     String            @unique
  status        AttendanceStatus
  markedBy      String            // Кто отметил (userId тренера или системы)
  markedAt      DateTime          @default(now())
  notes         String?
  createdAt     DateTime          @default(now())
  
  booking       Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([markedAt])
  @@map("attendances")
}

// Типы уведомлений
enum NotificationType {
  CLASS_REMINDER        // Напоминание о занятии (за 2 часа)
  CLASS_CANCELLED       // Занятие отменено
  CLASS_CHANGED         // Изменения в занятии
  PAYMENT_SUCCESS       // Успешная оплата
  PAYMENT_FAILED        // Ошибка оплаты
  LOW_BALANCE           // Низкий баланс
  SUBSCRIPTION_EXPIRING // Абонемент истекает
  SUBSCRIPTION_EXPIRED  // Абонемент истёк
  NEW_BOOKING           // Новая запись
  BOOKING_CANCELLED     // Запись отменена
  VOTING_STARTED        // Новое голосование
  VOTING_REMINDER       // Напоминание о голосовании
  VOTING_FINALIZED      // Голосование завершено
  NEW_STUDENT           // Новый ученик в группе
  TRAINER_MESSAGE       // Сообщение от тренера
  SYSTEM                // Системное уведомление
}

// Статусы уведомлений
enum NotificationStatus {
  PENDING   // Ожидает отправки
  SENT      // Отправлено
  FAILED    // Ошибка отправки
  READ      // Прочитано
  CANCELLED // Отменено
}

// Каналы доставки уведомлений
enum NotificationChannel {
  TELEGRAM // Telegram Bot
  EMAIL    // Email
  PUSH     // Push-уведомления
  SMS      // SMS
}

// Уведомления
model Notification {
  id            String              @id @default(uuid())
  userId        String
  type          NotificationType
  title         String
  content       String              @db.Text
  data          Json?               // Дополнительные данные (classId, paymentId и т.д.)
  channel       NotificationChannel @default(TELEGRAM)
  status        NotificationStatus  @default(PENDING)
  scheduledFor  DateTime?           // Когда запланирована отправка
  sentAt        DateTime?           // Когда отправлено
  readAt        DateTime?           // Когда прочитано
  errorMessage  String?             // Сообщение об ошибке (если FAILED)
  retryCount    Int                 @default(0) // Количество попыток отправки
  externalId    String?             // ID сообщения в Telegram/email и т.д.
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Relations
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([channel])
  @@index([scheduledFor])
  @@index([createdAt])
  @@map("notifications")
}

// Настройки уведомлений пользователя
model UserNotificationSettings {
  id                    String   @id @default(uuid())
  userId                String   @unique

  // Каналы доставки
  telegramEnabled       Boolean  @default(true)
  emailEnabled          Boolean  @default(false)
  pushEnabled           Boolean  @default(false)

  // Типы уведомлений
  classReminder         Boolean  @default(true)   // Напоминание о занятии (за 2 часа)
  classReminderMinutes  Int      @default(120)    // За сколько минут напоминать
  dailyReminder         Boolean  @default(false)  // Утреннее напоминание о занятиях
  dailyReminderTime     String?  @default("08:00") // Время утреннего напоминания

  lowBalanceThreshold   Int      @default(2)      // При скольки занятиях предупреждать
  lowBalanceEnabled     Boolean  @default(true)

  votingReminder        Boolean  @default(true)   // Напоминание о голосовании
  paymentReminder       Boolean  @default(true)   // Уведомления о платежах
  subscriptionReminders Boolean  @default(true)   // Уведомления об абонементе
  marketingEmails       Boolean  @default(false)  // Маркетинговые рассылки
  trainerNotifications  Boolean  @default(true)   // Уведомления от тренера

  timezone              String   @default("Europe/Moscow") // Часовой пояс

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // userId уже имеет @unique, отдельный @@index не нужен
  @@map("user_notification_settings")
}

// Промокоды для скидок
model PromoCode {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Int?      // Скидка в процентах (0-100)
  discountAmount  Int?      // Скидка в рублях
  validFrom       DateTime  @default(now())
  validUntil      DateTime
  maxUses         Int?      // Максимальное количество использований
  usedCount       Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // code уже имеет @unique, отдельный @@index не нужен
  @@index([isActive])
  @@index([validUntil])
  @@map("promo_codes")
}

// Реферальная программа
model Referral {
  id            String          @id @default(uuid())
  referrerId    String          // Кто пригласил
  referredId    String          // Кого пригласили
  status        ReferralStatus  @default(PENDING)
  rewardAmount  Int?            // Сумма вознаграждения в рублях
  rewardedAt    DateTime?
  createdAt     DateTime        @default(now())

  referrer      User            @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred      User            @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([referredId])
  @@index([status])
  @@map("referrals")
}

enum ReferralStatus {
  PENDING     // Ожидает выполнения условий
  COMPLETED   // Условия выполнены, вознаграждение начислено
  CANCELLED   // Отменено
}

// Отзывы учеников
model Review {
  id          String    @id @default(uuid())
  userId      String
  groupId     String
  rating      Int       // 1-5 звезд
  comment     String?   @db.Text
  isVisible   Boolean   @default(false) // Модерация
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([groupId])
  @@index([rating])
  @@index([isVisible])
  @@index([createdAt])
  @@map("reviews")
}

// Логи действий
model ActivityLog {
  id          String    @id @default(uuid())
  userId      String?
  action      String    // CREATE_BOOKING, UPDATE_PAYMENT и т.д.
  entityType  String    // booking, payment, user и т.д.
  entityId    String?
  metadata    Json?     // Дополнительные данные
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// Настройки системы
model SystemSetting {
  id          String    @id @default(uuid())
  key         String    @unique
  value       String    @db.Text
  description String?
  updatedAt   DateTime  @updatedAt

  // key уже имеет @unique, отдельный @@index не нужен
  @@map("system_settings")
}

// Лист ожидания
model Waitlist {
  id          String          @id @default(uuid())
  userId      String
  groupId     String?
  classId     String?
  priority    Int             @default(0) // Приоритет (чем выше, тем раньше)
  status      WaitlistStatus  @default(ACTIVE)
  createdAt   DateTime        @default(now())
  fulfilledAt DateTime?       // Когда место предоставлено

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group       Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([groupId])
  @@index([classId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("waitlists")
}

enum WaitlistStatus {
  ACTIVE      // В ожидании
  FULFILLED   // Место предоставлено
  CANCELLED   // Отменено пользователем
  EXPIRED     // Истекло время ожидания
}
